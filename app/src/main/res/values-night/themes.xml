<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Istiqamat" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Disable edge-to-edge drawing -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#050816</item>
        <item name="android:navigationBarColor">#050816</item>
        <item name="android:fitsSystemWindows">true</item>
        <!-- Fixes the bright white bounce ribbons on scroll -->
        <item name="android:windowBackground">#050816</item>
        <item name="android:colorEdgeEffect">#050816</item>
    </style>
</resources>